     Standard Preference (not TopLevelPreference) so that Settings'
     TopLevelPreferenceFragment inflates the M3 MaterialCardView wrapper
     around this row. TopLevelPreference is Settings-internal and skips
     the card container when used from an external package.
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="xiaomi_parts_settings"
        android:title="@string/xiaomi_parts_title"
        android:summary="@string/xiaomi_parts_summary"
        android:icon="@drawable/ic_xiaomi_parts"
        android:order="10"
        app:iconSpaceReserved="true" />

</PreferenceScreen>
