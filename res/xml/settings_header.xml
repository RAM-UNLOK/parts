     Settings preference-header declaration for Xiaomi Parts.

     This file is read by the AOSP Settings app via the
     com.android.settings.action.EXTRA_SETTINGS intent-filter on
     XiaomiPartsActivity.

     Using TopLevelPreference ensures it inherits the proper "Card"
     appearance inside the Android 12+ Settings homepage.
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto">

    <com.android.settingslib.widget.TopLevelPreference
        android:key="xiaomi_parts_settings"
        android:title="@string/xiaomi_parts_title"
        android:summary="@string/xiaomi_parts_summary"
        android:icon="@drawable/ic_xiaomi_parts" />

</PreferenceScreen>