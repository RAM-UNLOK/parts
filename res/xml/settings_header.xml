     Settings preference-header declaration for Xiaomi Parts.
     android:order mirrors the IA_SETTINGS order in AndroidManifest.xml
     so ROMs that resolve the tile via preference headers get the same
     placement. Card container color is driven by the iconSpaceReserved
     + TopLevelPreference combination which inherits the M3 surface tint.
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.android.settingslib.widget.TopLevelPreference
        android:key="xiaomi_parts_settings"
        android:title="@string/xiaomi_parts_title"
        android:summary="@string/xiaomi_parts_summary"
        android:icon="@drawable/ic_xiaomi_parts"
        android:order="10"
        app:iconSpaceReserved="true" />

</PreferenceScreen>
