     TopLevelPreference is the settingslib widget that Settings homepage
     uses to render each tile inside a MaterialCardView container with
     the correct M3 colorSurfaceVariant card background colour and the
     standard 28dp corner radius. Plain Preference does not receive that
     card treatment.
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <com.android.settingslib.widget.TopLevelPreference
        android:key="xiaomi_parts_settings"
        android:title="@string/xiaomi_parts_title"
        android:summary="@string/xiaomi_parts_summary"
        android:icon="@drawable/ic_xiaomi_parts"
        android:order="10" />

</PreferenceScreen>
