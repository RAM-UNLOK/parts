     Container inheritance: PreferenceScreen carries the M3 card container
     color via app:cardBackgroundColor, inheriting from the Monet
     colorSurfaceVariant token. The child Preference picks up the container
     shape and elevation from ?attr/preferenceStyle so the tile row renders
     inside a proper MaterialCardView on the Settings homepage.
-->
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="@dimen/settingslib_preferred_icon_size"
    app:cardElevation="0dp">

    <Preference
        android:key="xiaomi_parts_settings"
        android:title="@string/xiaomi_parts_title"
        android:summary="@string/xiaomi_parts_summary"
        android:icon="@drawable/ic_xiaomi_parts"
        android:order="10"
        app:iconSpaceReserved="true"
        app:allowDividerAbove="false"
        app:allowDividerBelow="false" />

</PreferenceScreen>
