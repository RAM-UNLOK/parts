<resources>

    <!-- 
        Use DeviceDefault.DayNight to natively hook into the system's Monet (Wallpaper) engine.
        This ensures WindowManager uses the dynamic color for the frame immediately, preventing UI flicker.
    -->
    <style name="XiaomiParts.Theme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <!-- Opaque background prevents transparent flicker -->
        <item name="android:windowIsTranslucent">false</item>
        
        <!-- Natively pulls the Dynamic Monet Background from the System (Wallpaper) -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>

        <!-- Edge-to-edge transparent system bars for Compose -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>

        <!-- Gesture nav — Compose content fills edge to edge -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- Soft keyboard — Compose WindowInsets.ime handles the rest -->
        <item name="android:windowSoftInputMode">adjustResize</item>

        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>

        <!-- No legacy ActionBar — Compose TopAppBar owns the chrome -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- M3 Expressive motion: system-level spring/overshoot hint -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

</resources>