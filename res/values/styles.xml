<resources>

    <!--
        Theme.Material3.DayNight.NoActionBar is the correct base for a Compose-only app.
        It carries Monet surface tokens so the Window background and system bars
        pick up dynamic color before Compose even renders, preventing the grey flash.
    -->
    <style name="XiaomiParts.Theme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>

        <!-- Pulls the Monet-tinted surface from M3 — resolves to dynamic color on API 31+ -->
        <item name="android:windowBackground">?attr/colorSurface</item>

        <!-- Edge-to-edge transparent system bars for Compose -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>

        <!-- Gesture nav — Compose content fills edge to edge -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>

        <!-- Soft keyboard — Compose WindowInsets.ime handles the rest -->
        <item name="android:windowSoftInputMode">adjustResize</item>

        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>

        <!-- No legacy ActionBar — Compose TopAppBar owns the chrome -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>

        <!-- M3 Expressive motion: system-level spring/overshoot hint -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

</resources>
