<resources>

    <!--
        XiaomiParts.Theme — window theme for XiaomiPartsActivity.

        Parent: @android:style/Theme.DeviceDefault.NoActionBar
          Guaranteed present in framework-res.apk on all AOSP/platform
          Soong builds. Do NOT use Theme.MaterialComponents.* or
          Theme.Material3.* here — those are Gradle/androidx artifacts
          not compiled into framework-res.apk and will fail aapt2 link.

        Compose draws its own surface so the window background just
        needs to match colorBackground (Monet-derived on Android 12+)
        to avoid a black flash on the first frame.
    -->
    <style name="XiaomiParts.Theme"
           parent="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- Match Monet/dynamic colorBackground so there is no flash
             before Compose paints its first frame. -->
        <item name="android:windowBackground">?android:attr/colorBackground</item>

        <!-- Edge-to-edge: draw behind both status and navigation bars. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Suppress system scrim overlays on transparent bars (API 29+). -->
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>

        <!-- Let content extend behind system bars. -->
        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>

        <!-- Let Compose WindowInsets.ime handle keyboard avoidance. -->
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

</resources>
