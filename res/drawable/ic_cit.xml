<?xml version="1.0" encoding="utf-8"?>
<!--
  CIT hardware diagnostics icon.
  Shape: rounded PCB chip with 4 pins each side.
  MD3 Expressive — single-layer, ?attr/colorControlNormal fill,
  no tint wrapper needed (fill references theme directly).
  24dp × 24dp viewport.
  SPDX-License-Identifier: Apache-2.0
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Chip body: rounded rectangle -->
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M15,4 H9 C6.79,4 5,5.79 5,8 V16 C5,18.21 6.79,20 9,20 H15 C17.21,20 19,18.21 19,16 V8 C19,5.79 17.21,4 15,4 Z
                          M9,6 H15 C16.1,6 17,6.9 17,8 V16 C17,17.1 16.1,18 15,18 H9 C7.9,18 7,17.1 7,16 V8 C7,6.9 7.9,6 9,6 Z" />

    <!-- Left pins (3) -->
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M3,9 H5 V10.5 H3 Z
                          M3,11.25 H5 V12.75 H3 Z
                          M3,13.5 H5 V15 H3 Z" />

    <!-- Right pins (3) -->
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M19,9 H21 V10.5 H19 Z
                          M19,11.25 H21 V12.75 H19 Z
                          M19,13.5 H21 V15 H19 Z" />

    <!-- Inner dot grid: 2×2 circuit nodes -->
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M10.5,10 m-0.75,0 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 Z
                          M13.5,10 m-0.75,0 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 Z
                          M10.5,14 m-0.75,0 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 Z
                          M13.5,14 m-0.75,0 a0.75,0.75 0 1,0 1.5,0 a0.75,0.75 0 1,0 -1.5,0 Z" />

    <!-- Connecting trace: horizontal line between nodes -->
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M10.5,11.75 H13.5 V12.25 H10.5 Z" />
</vector>
