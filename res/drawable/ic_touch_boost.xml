    Touch Boost icon.
    Concept: upright index finger pointing up, with three bold
    concentric speed-arc lines bursting from the fingertip to the
    upper-right, communicating fast/boosted touch response.
    Single compound path with evenOdd for the fingernail cutout.
    fillColor white — Compose Icon tint is the sole colour source.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        Finger body: upright rounded rectangle, wider at base,
        tapered slightly at tip. Centred left-of-centre to leave
        room for the speed arcs on the right.
        evenOdd cuts out a small rounded fingernail rectangle at the tip.
    -->
    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="
            M9,19
            L9,8
            C9,6.34 10.34,5 12,5
            C13.66,5 15,6.34 15,8
            L15,19
            C15,20.66 13.66,22 12,22
            C10.34,22 9,20.66 9,19
            Z

            M11,7
            L13,7
            L13,9
            C13,9.55 12.55,10 12,10
            C11.45,10 11,9.55 11,9
            Z
        "/>

    <!-- Speed arc 1 — closest to finger, short -->
    <path
        android:fillColor="@android:color/white"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="
            M16,6
            A5,5 0 0,1 19,10
        "/>

    <!-- Speed arc 2 — medium -->
    <path
        android:fillColor="@android:color/white"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="
            M17.5,4
            A7.5,7.5 0 0,1 21.5,11
        "/>

    <!-- Speed arc 3 — outermost -->
    <path
        android:fillColor="@android:color/white"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="
            M19,2
            A10,10 0 0,1 23.5,12
        "/>

</vector>
