<!--
    Settings launcher entry icon for Xiaomi Parts.
    Shown in the AOSP/Clover Settings preference list — rendered by the
    View-based Settings host at 24dp, so ?android:attr/colorControlNormal
    tint is appropriate (matches all other Clover Settings icons).

    Shape: CPU / processor chip with a square die, connection pads on all
    four sides, and a small highlight square in the centre of the die.
    Visually signals "device hardware tuning" — immediately distinct from
    the generic settings gear that was used previously.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24.0"
    android:viewportHeight="24.0"
    android:tint="?android:attr/colorControlNormal">

    <!--
        Chip body — rounded square die, drawn as a filled path.
        Pins on all four sides (3 per side), 1dp wide, 1.5dp long.
        Centre highlight square.
        All coordinates on the 24×24 grid, 2dp minimum stroke equivalent.
    -->
    <path
        android:fillColor="?android:attr/colorControlNormal"
        android:pathData="
            M9,3 L9,1 L11,1 L11,3
            M13,3 L13,1 L15,1 L15,3

            M9,21 L9,23 L11,23 L11,21
            M13,21 L13,23 L15,23 L15,21

            M3,9 L1,9 L1,11 L3,11
            M3,13 L1,13 L1,15 L3,15

            M21,9 L23,9 L23,11 L21,11
            M21,13 L23,13 L23,15 L21,15

            M7,3 L7,7 L3,7 L3,17 L7,17 L7,21
            L17,21 L17,17 L21,17 L21,7 L17,7 L17,3 Z

            M10,9 L10,15 L14,15 L14,9 Z
        "/>
</vector>
