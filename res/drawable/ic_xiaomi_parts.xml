    Settings homepage tile icon for Xiaomi Parts.

    LayerDrawable: teal circle background + white chip icon foreground.
    Matches the visual style of AOSP/Clover Settings homepage tiles
    (Battery, Security, System, etc.) which all use a coloured circle
    with a white icon centred inside.

    The foreground chip vector is inset ~28% on all sides so the icon
    sits at the same optical weight as system tile icons.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 0: coloured circle background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_xiaomi_parts_bg" />
        </shape>
    </item>

    <!-- Layer 1: chip icon, white, inset so it fills ~44% of the circle -->
    <item
        android:top="28%"
        android:bottom="28%"
        android:left="28%"
        android:right="28%">
        <vector
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24.0"
            android:viewportHeight="24.0">
            <path
                android:fillColor="#FFFFFF"
                android:pathData="
                    M9,3 L9,1 L11,1 L11,3
                    M13,3 L13,1 L15,1 L15,3

                    M9,21 L9,23 L11,23 L11,21
                    M13,21 L13,23 L15,23 L15,21

                    M3,9 L1,9 L1,11 L3,11
                    M3,13 L1,13 L1,15 L3,15

                    M21,9 L23,9 L23,11 L21,11
                    M21,13 L23,13 L23,15 L21,15

                    M7,3 L7,7 L3,7 L3,17 L7,17 L7,21
                    L17,21 L17,17 L21,17 L21,7 L17,7 L17,3 Z

                    M10,9 L10,15 L14,15 L14,9 Z
                "/>
        </vector>
    </item>

</layer-list>
