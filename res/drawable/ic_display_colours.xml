    Display Colours icon.
    Concept: six filled spectral arcs radiating from a bottom-centre
    pivot, representing the six colour modes (Vivid, Saturated,
    Standard, Original, P3, sRGB). Each arc is a bold wedge so the
    icon reads clearly at 24dp inside the row icon container.
    fillColor white — Compose Icon tint is the sole colour source.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!--
        Six equal 28° wedges, 4° gap between each, spanning 200° arc
        centred on top (pivot at 12,18.5, radius 14).
        Drawn as filled paths for maximum weight at small sizes.
    -->

    <!-- Wedge 1: far left -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="
            M12,18.5
            L3.08,10.05
            A10,10 0 0,1 4.93,7.45
            Z
        "/>

    <!-- Wedge 2 -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="
            M12,18.5
            L4.93,7.45
            A10,10 0 0,1 8.0,5.08
            Z
        "/>

    <!-- Wedge 3 (left-centre) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="
            M12,18.5
            L8.0,5.08
            A10,10 0 0,1 12,4.5
            Z
        "/>

    <!-- Wedge 4 (right-centre) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="
            M12,18.5
            L12,4.5
            A10,10 0 0,1 16.0,5.08
            Z
        "/>

    <!-- Wedge 5 -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="
            M12,18.5
            L16.0,5.08
            A10,10 0 0,1 19.07,7.45
            Z
        "/>

    <!-- Wedge 6: far right -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="
            M12,18.5
            L19.07,7.45
            A10,10 0 0,1 20.92,10.05
            Z
        "/>

    <!-- Centre pivot circle (punch-through via separate white overdraw
         is not needed — we draw a solid circle to cap the wedge tips
         cleanly, giving a lens/iris feel) -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="
            M12,16.5
            A2,2 0 1,0 12,20.5
            A2,2 0 1,0 12,16.5
            Z
        "/>

    <!-- Small inner mask circle to give hollow centre feel
         (drawn in transparent using clip — not available in VectorDrawable;
          instead use a same-surface-color fill in the Compose composable.
          This file provides the raw shape only.) -->

</vector>
